  "executive_summary": "\u0647\u0630\u0627 \u0627\u0644\u0639\u0642\u062f \u064a\u062d\u062f\u062f \u0639\u0644\u0627\u0642\u0629 \u0634\u0631\u0643\u0629 \u062a\u062c\u0627\u0631\u064a\u0629 \u0645\u0639 \u0634\u0631\u0643\u0629 \u0644\u0648\u062c\u0633\u062a\u064a\u0629 \u0644\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u062a\u062e\u0632\u064a\u0646 \u0648\u0627\u0644\u0646\u0642\u0644 \u0644\u0645\u062f\u0629 \u0639\u0627\u0645\u064a\u0646. \u064a\u062a\u0636\u0645\u0646 \u0627\u0644\u0639\u0642\u062f \u0631\u0633\u0648\u0645\u064b\u0627 \u0634\u0647\u0631\u064a\u0629 \u0648\u0645\u0633\u062a\u0648\u064a\u0627\u062a \u062e\u062f\u0645\u0629\u060c \u0648\u064a\u062d\u062f\u062f \u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0627\u0644\u0646\u0642\u0644 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0646\u0642\u0644 \u0648\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0627\u0644\u0639\u0645\u064a\u0644 \u0628\u0639\u062f \u0648\u0635\u0648\u0644 \u0627\u0644\u0628\u0636\u0627\u0639\u0629 \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639\u060c \u0644\u0643\u0646 \u0644\u0627 \u064a\u0648\u0636\u062d \u0628\u062f\u0642\u0629 \u0644\u062d\u0638\u0629 \u0627\u0646\u062a\u0642\u0627\u0644 \u0627\u0644\u0645\u062e\u0627\u0637\u0631. \u0647\u0646\u0627\u0643 \u0625\u0634\u0627\u0631\u0629 \u0625\u0644\u0649 \u0648\u062c\u0648\u062f \u062a\u0623\u0645\u064a\u0646 \u062f\u0648\u0646 \u062a\u0648\u0636\u064a\u062d \u0642\u064a\u0645\u0629 \u0627\u0644\u062a\u063a\u0637\u064a\u0629 \u0623\u0648 \u0627\u0644\u0645\u062e\u0627\u0637\u0631 \u0627\u0644\u0645\u0634\u0645\u0648\u0644\u0629\u060c \u0643\u0645\u0627 \u064a\u062d\u062f\u062f \u062d\u062f\u064b\u0627 \u0623\u0642\u0635\u0649 \u0644\u0644\u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u062f\u0648\u0646 \u062a\u0648\u0636\u064a\u062d \u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u064a\u0634\u0645\u0644 \u0627\u0644\u062a\u0644\u0641 \u0623\u0648 \u0627\u0644\u0625\u0647\u0645\u0627\u0644. \u0627\u0644\u0639\u0642\u062f \u064a\u0637\u0644\u0628 \u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u0627\u0644\u062d\u0648\u0627\u062f\u062b \"\u0641\u0648\u0631\u0627\u064b\" \u062f\u0648\u0646 \u062a\u062d\u062f\u064a\u062f \u0648\u0633\u064a\u0644\u0629 \u0623\u0648 \u0645\u0647\u0644\u0629 \u062f\u0642\u064a\u0642\u0629\u060c \u0645\u0645\u0627 \u0642\u062f \u064a\u062e\u0644\u0642 \u062e\u0644\u0627\u0641\u064b\u0627 \u062d\u0648\u0644 \u0627\u0633\u062a\u062d\u0642\u0627\u0642 \u0627\u0644\u062a\u0639\u0648\u064a\u0636.",
